NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for payment verification (server-only, NEVER prefix with NEXT_PUBLIC_).
# Get this from Supabase project settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Required for online/UPI payments (Razorpay). Get these from your Razorpay
# dashboard > Settings > API Keys. Server-only — never exposed to the browser
# except RAZORPAY_KEY_ID, which the payment API route returns to the client
# because Razorpay's checkout widget requires it (it is a public identifier,
# not a secret).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
