NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for payment verification (server-only, NEVER prefix with NEXT_PUBLIC_).
# Get this from Supabase project settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Required for online/UPI payments (Razorpay). Get these from your Razorpay
# dashboard > Settings > API Keys. Server-only — never exposed to the browser
# except RAZORPAY_KEY_ID, which the payment API route returns to the client
# because Razorpay's checkout widget requires it (it is a public identifier,
# not a secret).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required for web push notifications (Part E). Generate a key pair once
# locally with `npx web-push generate-vapid-keys` and paste the two keys
# below. VAPID_SUBJECT should be a mailto: link or your site URL — it's
# sent to push services so they can contact you if something's wrong.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Shared secret the Supabase DB trigger (20_web_push.sql) sends back to
# this app to authenticate its webhook call — it isn't a user secret, just
# needs to match the value you set in `app_config.push_webhook_secret` in
# the database. Generate any random string, e.g. `openssl rand -hex 32`.
PUSH_WEBHOOK_SECRET=

# Required for email notifications (Part E). Sign up at resend.com (free
# tier covers small volume), verify your sending domain there, then paste
# the API key below. EMAIL_FROM_ADDRESS must be on that verified domain
# (e.g. notifications@yourdomain.com) — Resend will reject unverified
# senders. SUPPORT_EMAIL is shown in the footer of every email; defaults
# to EMAIL_FROM_ADDRESS if not set.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
SUPPORT_EMAIL=

# Your deployed site's base URL, used to build the links inside push/email
# notifications (e.g. https://kissaan-saathi.vercel.app, no trailing slash).
NEXT_PUBLIC_APP_URL=
